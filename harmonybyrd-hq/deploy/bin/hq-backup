#!/usr/bin/env bash
# Nightly backup (run by hq-backup.timer, as root):
#   1. pg_dump of the whole database (credentials included, so a restore is complete);
#   2. restore that dump into a scratch database and run the integrity checks on it, so every backup
#      is known to restore before it is kept;
#   3. encrypt it with age to the founder's PUBLIC key(s) in /etc/hq/backup-recipients.txt (the private
#      key is never on the server, so the server cannot read its own backups);
#   4. keep 35 days, and record success in backups/LAST_OK for the health check.
. "$(dirname "$(readlink -f "$0")")/hq-common.sh"

backups="$HQ_VAR/backups"
recipients="$HQ_ETC/backup-recipients.txt"
grep -q '^age1' "$recipients" 2>/dev/null || die "no age public key in $recipients: backups cannot be encrypted (see deploy/README.md)"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
work="$(pg mktemp -d)"; trap 'pg rm -rf "$work"; pg dropdb --if-exists hq_backup_check >/dev/null 2>&1 || true' EXIT
plain="$work/hq-$stamp.dump"

log "Dumping $HQ_DB"
pg pg_dump -Fc -Z9 -d "$HQ_DB" -f "$plain"

log "Restore test of this dump"
pg dropdb --if-exists hq_backup_check
pg createdb hq_backup_check
pg pg_restore --exit-on-error -d hq_backup_check "$plain"
integrity_check hq_backup_check | sed 's/^/   /' || die "the backup restored but failed its integrity checks; it was NOT kept"
src_count="$(psql_db "$HQ_DB" -Atc "select count(*) from hq.record_versions")"
bak_count="$(psql_db hq_backup_check -Atc "select count(*) from hq.record_versions")"
[ "$src_count" = "$bak_count" ] || die "record versions differ: live $src_count, backup $bak_count"
pg dropdb hq_backup_check

log "Encrypting"
out="$backups/hq-$stamp.dump.age"
pg age -R "$recipients" -o "$out" "$plain"
pg sh -c "cd '$backups' && sha256sum '$(basename "$out")' > '$(basename "$out").sha256'"
printf '%s %s record_versions=%s\n' "$stamp" "$(basename "$out")" "$src_count" | pg tee "$backups/LAST_OK" >/dev/null
pg chmod 0640 "$out" "$out.sha256" "$backups/LAST_OK"   # readable by the hqbackup group: encrypted, so safe to copy

log "Pruning backups older than 35 days"
pg find "$backups" -maxdepth 1 -name 'hq-*.dump.age*' -mtime +35 -delete
log "Backup OK: $out ($(pg du -h "$out" | cut -f1))"
