# The real HarmonyByrd evidence pack and anything derived from founder documents stay out of
# the repository. Only the synthetic fixture pack is committed.
data/packs/*
!data/packs/fixture/
private/

# Generated by tests/mutation/gen.py
tests/mutation/mut/

# The repository this folder sits in ignores *.mjs. HQ needs its own: next.config.mjs carries the
# response headers, and the mutation check is run by tests/mutation/run.mjs.
!*.mjs

# The repository this folder sits in also ignores bin/. The server operations scripts live in deploy/bin.
!deploy/bin/
