# HarmonyByrd HQ — environment. `npm run setup` copies this to .env.local, fills in the two
# __GENERATED_…__ values (also in an existing .env.local that still has them) and makes the file
# readable by its owner only (chmod 600). If you copy it by hand and do not run setup, replace both
# placeholders with long random strings (for example `openssl rand -base64 48`) and run `chmod 600 .env.local`.
#
# Owner connection: used ONLY by setup, migrations, seeding and the test harness. Never by the web application.
HQ_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/hq_dev

# Application connection: a NOINHERIT login role with no privileges of its own (created by `npm run db:migrate`).
DATABASE_URL=postgres://hq_app:__GENERATED_APP_DB_PASSWORD__@127.0.0.1:54329/hq_dev

# HS256 signing secret for session tokens (>= 32 chars). The application will not start with the placeholder.
# On Supabase, use the project's JWT secret.
HQ_JWT_SECRET=__GENERATED_JWT_SECRET__

# Evidence pack imported by `npm run db:seed`.
#   data/packs/fixture                 synthetic records for tests (committed)
#   data/packs/harmonybyrd-evidence    the real HarmonyByrd evidence pack (private; not committed)
HQ_PACK_DIR=data/packs/fixture

HQ_BASE_URL=http://localhost:3210

# Optional read-only integrations. Leave empty to run without them; HQ reports them as "not configured".
HQ_GITHUB_TOKEN=
HQ_GITHUB_REPOSITORIES=
HQ_GOOGLE_DRIVE_ACCESS_TOKEN=
# Comma-separated Google Drive file ids that live look-ups may read. Any other id is "not configured".
HQ_GOOGLE_DRIVE_FILE_IDS=

# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For: the address is then
# recorded in the audit log for failed sign-ins. The sign-in delay is per name and never uses it.
# HQ_TRUST_PROXY=1
# Largest JSON request body accepted by the REST and MCP endpoints, in bytes (default 1048576).
# HQ_MAX_BODY_BYTES=1048576
