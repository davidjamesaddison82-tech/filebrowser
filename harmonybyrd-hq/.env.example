# HarmonyByrd HQ — environment. `npm run setup` copies this to .env.local and fills in the generated values.
#
# Owner connection: used ONLY by setup, migrations, seeding and the test harness. Never by the web application.
HQ_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/hq_dev

# Application connection: a NOINHERIT login role with no privileges of its own (created by `npm run db:migrate`).
DATABASE_URL=postgres://hq_app:__GENERATED_APP_DB_PASSWORD__@127.0.0.1:54329/hq_dev

# HS256 signing secret for session tokens (>= 32 chars). On Supabase, use the project's JWT secret.
HQ_JWT_SECRET=__GENERATED_JWT_SECRET__

# Evidence pack imported by `npm run db:seed`.
#   data/packs/fixture                 synthetic records for tests (committed)
#   data/packs/harmonybyrd-evidence    the real HarmonyByrd evidence pack (private; not committed)
HQ_PACK_DIR=data/packs/fixture

HQ_BASE_URL=http://localhost:3210

# Optional read-only integrations. Leave empty to run without them; HQ reports them as "not configured".
HQ_GITHUB_TOKEN=
HQ_GITHUB_REPOSITORIES=
HQ_GOOGLE_DRIVE_ACCESS_TOKEN=
